Options -Indexes
DirectoryIndex index.php
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On

# Keep private implementation/docs out of the public surface.
RewriteRule ^(?:config|includes|docs|python|scripts)/ - [F,L]

# Crawl endpoints use dynamic base/origin awareness.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L,QSA]

# Existing files and asset directories are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Standalone product surfaces.
RewriteRule ^intelligence/?$ intelligence.php [L,QSA]

# Canonical live tool.
RewriteRule ^muhurat/choghadiya/?$ choghadiya.php [L,QSA]

# Every mapped Tithika page resolves through the shared renderer.
RewriteRule ^(.+?)/?$ page.php?slug=$1 [L,QSA]
</IfModule>

<FilesMatch "^(README\.md|sample\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webmanifest|svg|webp|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
